    {
        "id": "fn_controller",
        "type": "function",
        "z": "72473b3995ff3a3b",
        "name": "Kontroler HVAC + Purifier",
        "func": "const TARGET = 21.0;\nconst EPS = 0.05; // strefa martwa\nconst PUR_THRESHOLD = 80; // %\n\n// oczekujemy dwóch rodzajów wejść: temperatura i jakość\n// najlepiej podać ten node dwoma przewodami (z TEMP IN i AQI IN)\n\nlet t = flow.get('last_temp');\nlet q = flow.get('last_aqi');\n\nif (msg.topic && msg.topic.includes('temperature')) {\n  t = parseFloat(msg.payload);\n  if (!isNaN(t)) flow.set('last_temp', t);\n}\nif (msg.topic && msg.topic.includes('aqi')) {\n  q = parseFloat(msg.payload);\n  if (!isNaN(q)) flow.set('last_aqi', q);\n}\n\nlet out_cmds = [];\n\n// HVAC: decyduj tylko jeśli mamy temp\nif (typeof t === 'number') {\n  if (t > TARGET + EPS) {\n    // za ciepło -> CHŁODZENIE ON (grzanie OFF)\n    out_cmds.push({topic:`home/room1/cmd/heating`, payload:'OFF'});\n    out_cmds.push({topic:`home/room1/cmd/ac`, payload:'ON'});\n  } else if (t < TARGET - EPS) {\n    // za zimno -> GRZANIE ON (chłodzenie OFF)\n    out_cmds.push({topic:`home/room1/cmd/ac`, payload:'OFF'});\n    out_cmds.push({topic:`home/room1/cmd/heating`, payload:'ON'});\n  } else {\n    // w pobliżu celu -> wszystko OFF\n    out_cmds.push({topic:`home/room1/cmd/ac`, payload:'OFF'});\n    out_cmds.push({topic:`home/room1/cmd/heating`, payload:'OFF'});\n  }\n}\n\n// Purifier: decyduj jeśli mamy jakość\nif (typeof q === 'number') {\n  if (q < PUR_THRESHOLD) {\n    out_cmds.push({topic:`home/room1/cmd/airpurifier`, payload:'ON'});\n  } else {\n    out_cmds.push({topic:`home/room1/cmd/airpurifier`, payload:'OFF'});\n  }\n}\n\nreturn [out_cmds];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 320,
        "wires": [
            [
                "mqtt_out_cmd"
            ]
        ]

        "name": "LED Purifier",
        "order": 4,
        "width": "",
        "height": "",
        "format": "<style>\n    .card {\n        padding: 8px 12px;\n        border: 1px solid #ddd;\n        border-radius: 8px;\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        margin: 4px 0\n    }\n\n    .dot {\n        width: 14px;\n        height: 14px;\n        border-radius: 50%;\n        background: #c00;\n        box-shadow: 0 0 6px rgba(0, 0, 0, .3)\n    }\n\n    .dot.on {\n        background: #0a0\n    }\n\n    @keyframes blink {\n\n        0%,\n        60% {\n            opacity: 1\n        }\n\n        80% {\n            opacity: .4\n        }\n\n        100% {\n            opacity: 1\n        }\n    }\n\n    .dot.blink {\n        animation: blink 1s infinite\n    }\n\n    .title {\n        font-weight: 700\n    }\n\n    .state {\n        font-weight: 700\n    }\n</style>\n\n<div class=\"card\">\n    <div class=\"dot\" ng-class=\"{'on': (msg.payload==='ON'), 'blink': (msg.payload==='ON')}\"></div>\n    <span class=\"title\">Oczyszczacz powietrza:</span>\n    <span class=\"state\">\n    {{ msg.payload==='ON' ? 'działa' : 'OFF' }}\n  </span>\n</div>",
        "storeOutMessages": true,

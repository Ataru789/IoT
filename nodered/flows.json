    {
        "id": "fn_inject_aqi",
        "type": "function",
        "z": "72473b3995ff3a3b",
        "name": "To MQTT inject AQI",
        "func": "let v = parseFloat(msg.payload);\nif (isNaN(v)) return null;\nv = Math.max(0, Math.min(100, v));\nreturn { payload: String(Math.round(v)), topic: 'home/room1/inject/aqi' };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
